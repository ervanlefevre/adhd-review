#!/usr/bin/env bash
# Builds dist/adhd-review-<version>.zip: the files Chrome needs to load the extension
# unpacked (manifest, src, README). Tests and git metadata are left out.
set -euo pipefail
cd "$(dirname "$0")/.."
version=$(node -p "require('./manifest.json').version")
suffix=${1:-}
name="adhd-review-${version}${suffix:+-$suffix}"
rm -rf "dist/$name" "dist/$name.zip"
mkdir -p "dist/$name"
cp -R manifest.json src README.md "dist/$name/"
(cd dist && zip -qr "$name.zip" "$name")
rm -rf "dist/$name"
echo "dist/$name.zip"
